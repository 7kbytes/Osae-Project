rules_version = '2';

// Least-privilege rules. Matrix and rationale: docs/03-security-and-compliance.md
// Tests: rules-tests/ (run with `npm test` inside that folder).
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers -----------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Admin dashboard (web/admin). Create admins/{uid} documents by hand in the
    // Firebase console; clients can never write them. To be replaced by custom
    // claims (docs/05).
    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isStr(v, max) {
      return v is string && v.size() > 0 && v.size() <= max;
    }

    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // ---- admins ------------------------------------------------------------

    match /admins/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // ---- users -------------------------------------------------------------

    function validUser() {
      let d = request.resource.data;
      return isStr(d.displayName, 100) &&
        d.role in ['seeker', 'poster'] &&
        (!('phone' in d) || (d.phone is string && d.phone.size() <= 30)) &&
        (!('city' in d) || (d.city is string && d.city.size() <= 60));
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      // Rating starts at the default and only admins (later: Functions) change
      // it; createdAt never changes.
      allow create: if isOwner(userId) && validUser() &&
        (!('rating' in request.resource.data) ||
          request.resource.data.rating == 5);
      allow update: if (isOwner(userId) && validUser() &&
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['rating', 'createdAt'])) ||
        isAdmin();
      allow delete: if isOwner(userId) || isAdmin();

      // Per-user saved jobs.
      match /favorites/{jobId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ---- jobs --------------------------------------------------------------

    function validJob() {
      let d = request.resource.data;
      // Jobs are public: the poster's phone must never be stored on them.
      return !('posterPhone' in d) &&
        isStr(d.title, 120) &&
        d.description is string && d.description.size() <= 5000 &&
        d.payRate is number && d.payRate >= 0 &&
        d.posterId is string &&
        (!('status' in d) || d.status in ['open', 'inProgress', 'completed']) &&
        // Search keywords: bounded so a poster cannot bloat the document.
        (!('searchTerms' in d) ||
          (d.searchTerms is list && d.searchTerms.size() <= 60));
    }

    match /jobs/{jobId} {
      allow read: if true; // Public job listings
      allow create: if isSignedIn() &&
        request.resource.data.posterId == request.auth.uid && validJob();
      allow update: if (isOwner(resource.data.posterId) &&
          request.resource.data.posterId == resource.data.posterId && validJob()) ||
        isAdmin();
      allow delete: if isOwner(resource.data.posterId) || isAdmin();
    }

    function jobPoster(jobId) {
      return get(/databases/$(database)/documents/jobs/$(jobId)).data.posterId;
    }

    // ---- applications ------------------------------------------------------

    function validTransition(from, to) {
      return from == to ||
        (from == 'pending' && to in ['accepted', 'rejected']) ||
        (from == 'accepted' && to in ['completed', 'rejected']);
    }

    match /applications/{applicationId} {
      allow read: if isOwner(resource.data.seekerId) ||
        isOwner(resource.data.posterId) || isAdmin();

      // A seeker may only create a pending application in their own name, for
      // a real job and its real poster. The fixed id allows one per job.
      allow create: if isSignedIn() &&
        applicationId == request.resource.data.jobId + '_' + request.auth.uid &&
        !('posterPhone' in request.resource.data) &&
        jobPoster(request.resource.data.jobId) == request.resource.data.posterId &&
        request.resource.data.seekerId == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.posterId is string &&
        request.resource.data.jobId is string &&
        (!('note' in request.resource.data) ||
          (request.resource.data.note is string &&
           request.resource.data.note.size() <= 1000));

      // The poster may move the status forward and, on accepting, share their
      // phone with this seeker. Nothing else.
      allow update: if (isOwner(resource.data.posterId) &&
          validTransition(resource.data.status, request.resource.data.status) &&
          (changedOnly(['status']) ||
            (changedOnly(['status', 'posterPhone']) &&
             request.resource.data.status == 'accepted' &&
             request.resource.data.posterPhone is string &&
             request.resource.data.posterPhone.size() <= 30))) ||
        isAdmin();

      allow delete: if isAdmin();
    }

    // ---- chats -------------------------------------------------------------

    function isChatMember(chat) {
      return isSignedIn() &&
        (request.auth.uid == chat.seekerId || request.auth.uid == chat.posterId);
    }

    match /chats/{chatId} {
      allow read: if isChatMember(resource.data) || isAdmin();
      // A chat is always about a real job with that job's poster, so nobody
      // can open one with an arbitrary user.
      allow create: if isChatMember(request.resource.data) &&
        jobPoster(request.resource.data.jobId) == request.resource.data.posterId;
      allow update: if (isChatMember(resource.data) &&
          changedOnly(['lastMessage', 'updatedAt'])) || isAdmin();
      allow delete: if isAdmin();

      match /messages/{messageId} {
        function chat() {
          return get(/databases/$(database)/documents/chats/$(chatId)).data;
        }

        allow read: if isChatMember(chat()) || isAdmin();
        // The id is restricted because the admin dashboard renders it.
        allow create: if messageId.matches('^[A-Za-z0-9_-]{1,128}$') &&
          isChatMember(chat()) &&
          request.resource.data.senderId == request.auth.uid &&
          isStr(request.resource.data.text, 2000);
        // Members may only mark a message as read.
        allow update: if isChatMember(chat()) && changedOnly(['isRead']);
        allow delete: if isAdmin();
      }
    }

    // ---- reports -----------------------------------------------------------

    match /reports/{reportId} {
      // Reporters can see their own reports; admins see and handle them all.
      allow read: if isOwner(resource.data.reporterId) || isAdmin();
      allow create: if isSignedIn() &&
        request.resource.data.reporterId == request.auth.uid &&
        request.resource.data.status == 'open' &&
        request.resource.data.targetType in ['job', 'user', 'message'] &&
        isStr(request.resource.data.targetId, 200) &&
        isStr(request.resource.data.reason, 200) &&
        (!('note' in request.resource.data) ||
          (request.resource.data.note is string &&
           request.resource.data.note.size() <= 1000));
      allow update: if isAdmin() && changedOnly(['status']);
      allow delete: if isAdmin();
    }

    // Everything else is denied by default.
  }
}
